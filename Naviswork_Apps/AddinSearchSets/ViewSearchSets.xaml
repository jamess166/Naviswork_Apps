<Window x:Class="Naviswork_Apps.AddinSearchSets.ViewSearchSets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Naviswork_Apps.AddinSearchSets"
        mc:Ignorable="d"
        Title="Crear busquedas por PR-Elemento"
        Width="480" Height="440" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Seleccione los modelos para los que se crearan las busquedas. Los demas conjuntos no se tocan."
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Todos" Width="72" Padding="6,3" Click="SelectAll_Click" Margin="0,0,6,0"/>
            <Button Content="Ninguno" Width="72" Padding="6,3" Click="SelectNone_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#FFAAAAAA" BorderThickness="1">
            <ListBox Name="lstModels"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding PrefixLabel}" Foreground="Gray" Margin="10,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" Name="lblStatus" Margin="0,8,0,6" Foreground="#FF444444"/>

        <TextBox Grid.Row="4" Name="txtLog"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="11"
                 Background="#FFF7F7F7"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="btnPreview" Content="Previsualizar" Padding="14,5" Click="Preview_Click"/>
            <Button Name="btnCreate" Content="Crear faltantes" Padding="14,5" Margin="8,0,0,0" Click="Create_Click"/>
            <Button Content="Cerrar" Padding="14,5" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
